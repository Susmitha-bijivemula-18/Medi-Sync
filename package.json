{
  "name": "medisync-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "MediSync Healthcare Appointment & Queue Management Platform",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./dev.ps1",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && .\\mvnw.cmd spring-boot:run",
    "stop": "powershell -ExecutionPolicy Bypass -File ./stop-dev.ps1",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && .\\mvnw.cmd compile"
  }
}
